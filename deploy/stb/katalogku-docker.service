[Unit]
Description=Docker Engine for KatalogKu
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
RuntimeDirectory=katalogku-docker
ExecStart=/usr/bin/dockerd --host=unix:///var/run/docker.sock --data-root=/opt/katalogku-runtime/docker --exec-root=/run/katalogku-docker --pidfile=/run/katalogku-docker/docker.pid --bip=172.29.255.1/24 --default-address-pool=base=172.29.0.0/16,size=24 --storage-driver=overlay2 --log-opt=max-size=5m --log-opt=max-file=2
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
Delegate=yes
KillMode=process
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
